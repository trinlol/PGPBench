{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PocketPGP",
  "version": "0.1.3",
  "identifier": "com.pocketpgp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PocketPGP",
        "width": 1080,
        "height": 760,
        "minWidth": 720,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://github.com https://*.github.com https://*.githubusercontent.com",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMTc3NzRFNTNGMEQyNDYKUldSRzB2QlRUbmNYdkFNSEpxZi9LT0wxVEs0b1haSmRrSTVtZFhsanNIbWhQazgzK1I1Y0tiL0kK",
      "endpoints": [
        "https://github.com/trinlol/PocketPGP/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "PocketPGP contributors",
    "shortDescription": "Offline OpenPGP for Windows",
    "longDescription": "A minimal, modern, fully-offline OpenPGP app for Windows - a clipboard-first alternative to Kleopatra. Generate keys, encrypt, decrypt, sign and verify by paste. Keys never leave your device.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
